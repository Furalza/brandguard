# Copy to .env. Real environment variables always take precedence over this file.

# T2 text reader: set ONE of these, or none for the deterministic rule adjudicator
# (then listing text is not read). The model answers questions about the
# listing text; the rules decide.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Override the model (defaults: claude-sonnet-4-6 / gpt-4o-mini)
# BRANDGUARD_LLM_MODEL=gpt-4o-mini
# Readings are cached in data/t2_cache.sqlite; set 0 to disable the cache
# BRANDGUARD_T2_CACHE=1

# Google search via Serper (APK sites, website hunt, domain discovery).
# SERPER_API_KEY=...

# Product settings (defaults shown)
# BRANDGUARD_DATABASE_URL=sqlite:///data/brandguard.db
# BRANDGUARD_DATA_DIR=data
# BRANDGUARD_WEB_DIST=web/dist
# One shared login for the console when it is reachable beyond localhost
# (demo over a tunnel, office LAN). Unset = no login.
# BRANDGUARD_BASIC_AUTH=demo:change-me
